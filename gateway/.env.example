PORT=3939
BACKEND_API_URL=https://backend.example.com
PATH_PREFIX=/dui/gw
API_PREFIX=/api/v1

# Subscription clients cannot execute AES. These paths are proxied directly.
# Set SUBSCRIPTION_PREFIX=off to disable subscription passthrough completely.
SUBSCRIPTION_PREFIX=/s
BACKEND_SUBSCRIPTION_PREFIX=/s

# Browser access control.
CORS_ORIGIN=*
ALLOWED_ORIGINS=*

REQUEST_TIMEOUT=30000
ENABLE_LOGGING=false
DEBUG_MODE=false

# Comma-separated direct passthrough paths for payment provider callbacks.
# Set this to an empty value to disable payment callback passthrough.
ALLOWED_PAYMENT_NOTIFY_PATHS=/api/v1/guest/payment/notify

# 16, 24, or 32 UTF-8 bytes. The browser client uses the same value.
AES_KEY=0123456789abcdef
